<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Food Ordering Management System" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <!-- Kolom Form Pesanan -->
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="30"/>
            <!-- Kolom Daftar Pesanan -->
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <!-- FORM INPUT PESANAN (KIRI) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="FOOD ORDERING APP" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="#D32F2F"/>

                <!-- Control 1: TextBox -->
                <TextBlock Text="Nama Pelanggan" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNamaPelanggan" Height="32" Margin="0,4,0,10" VerticalContentAlignment="Center"/>

                <!-- Control 2: ComboBox -->
                <TextBlock Text="Pilihan Menu" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbMenu" Height="32" Margin="0,4,0,10" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Nasi Goreng Spesial - Rp 25.000"/>
                    <ComboBoxItem Content="Ayam Geprek Sambal Korek - Rp 20.000"/>
                    <ComboBoxItem Content="Mie Ayam Bakso - Rp 18.000"/>
                    <ComboBoxItem Content="Es Teh Manis Jumbo - Rp 5.000"/>
                    <ComboBoxItem Content="Jus Alpukat - Rp 12.000"/>
                </ComboBox>

                <TextBlock Text="Jumlah Porsi" FontWeight="SemiBold"/>
                <TextBox x:Name="txtJumlah" Height="32" Margin="0,4,0,10" VerticalContentAlignment="Center"/>

                <!-- Control 3: RadioButton -->
                <TextBlock Text="Tipe Layanan" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                    <RadioButton x:Name="rbDineIn" Content="Dine In (Makan di Tempat)" Margin="0,0,20,0" IsChecked="True"/>
                    <RadioButton x:Name="rbTakeAway" Content="Take Away (Bungkus)"/>
                </StackPanel>

                <!-- Control 4: DatePicker -->
                <TextBlock Text="Tanggal Pesanan" FontWeight="SemiBold"/>
                <DatePicker x:Name="dpTanggal" Height="32" Margin="0,4,0,10"/>

                <!-- Control 5: CheckBox -->
                <TextBlock Text="Opsi Tambahan" FontWeight="SemiBold"/>
                <StackPanel Margin="0,4,0,10">
                    <CheckBox x:Name="chkPedas" Content="Extra Pedas" Margin="0,0,0,5"/>
                    <CheckBox x:Name="chkTakeAwayPackaging" Content="Kemasan Ramah Lingkungan (+Rp 2.000)"/>
                </StackPanel>

                <TextBlock Text="Catatan Khusus" FontWeight="SemiBold"/>
                <TextBox x:Name="txtCatatan" Height="60" Margin="0,4,0,15" TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Control 6: Button (Event: Click) -->
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="btnSimpan" Content="Simpan Pesanan" Width="130" Height="35" Margin="0,0,10,0" Click="BtnSimpan_Click"/>
                    <Button x:Name="btnReset" Content="Reset Form" Width="100" Height="35" Click="BtnReset_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- DATA PESANAN (KANAN) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="DAFTAR PESANAN MASUK" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Event: TextChanged -->
            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="Cari Pesanan: " VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="txtSearch" Height="30" TextChanged="TxtSearch_TextChanged"/>
            </DockPanel>

            <!-- Control 7: ListBox (Event: SelectionChanged) -->
            <ListBox x:Name="lstPesanan" Grid.Row="2" Margin="0,0,0,10" SelectionChanged="LstPesanan_SelectionChanged"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Hapus Pesanan" Width="120" Height="35" Click="BtnHapus_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtStatus" Grid.Row="4" Text="Total Pesanan: 0" FontSize="14" FontWeight="Bold" Foreground="#333"/>
        </Grid>
    </Grid>
</Window>